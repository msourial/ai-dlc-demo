# Copy this file to `.env` and fill in your own keys.
# Never commit the real `.env` (it is gitignored).

# OpenRouter API key — https://openrouter.ai/settings/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# GitHub Personal Access Token with "repo" scope — https://github.com/settings/tokens
VITE_GITHUB_TOKEN=github_pat_your_token_here